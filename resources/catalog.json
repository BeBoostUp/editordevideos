  "color_grades": {
    "description": "Presets de color grading con filtros FFmpeg",
    "items": {
      "none": {
        "name": "Sin efecto",
        "filter": "",
        "mood": "neutral"
      },
      "vivid": {
        "name": "Vivido",
        "filter": "eq=saturation=1.4:contrast=1.1:brightness=0.03",
        "mood": "alegre"
      },
      "warm": {
        "name": "Calido",
        "filter": "colorbalance=rs=0.15:gs=0.05:bs=-0.1:rm=0.1:gm=0.02:bm=-0.05,eq=saturation=1.1",
        "mood": "acogedor"
      },
      "cool": {
        "name": "Frio",
        "filter": "colorbalance=rs=-0.1:gs=-0.05:bs=0.2:rh=-0.08:bh=0.15,eq=contrast=1.1",
        "mood": "profesional"
      },
      "vintage": {
        "name": "Vintage",
        "filter": "curves=preset=vintage,eq=saturation=0.8:contrast=1.15",
        "mood": "nostalgico"
      },
      "cinematic": {
        "name": "Cinematico",
        "filter": "colorbalance=rs=0.15:gs=-0.05:bs=-0.15:rm=0.05:bm=0.1:bh=0.12,eq=saturation=0.9:contrast=1.2:brightness=-0.03",
        "mood": "drama"
      },
      "bw": {
        "name": "Blanco y Negro",
        "filter": "hue=s=0,eq=contrast=1.2",
        "mood": "artistico"
      },
      "moody": {
        "name": "Moody/Dark",
        "filter": "eq=brightness=-0.08:contrast=1.3:saturation=0.7,curves=preset=darker",
