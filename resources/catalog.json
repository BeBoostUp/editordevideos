        "mood": "hollywood"
      },
      "sepia": {
        "name": "Sepia",
        "filter": "colorchannelmixer=.393:.769:.189:0:.349:.686:.168:0:.272:.534:.131:0",
        "mood": "retro"
      },
      "noir": {
        "name": "Film Noir",
        "filter": "hue=s=0,eq=contrast=1.4:brightness=-0.05,curves=preset=increase_contrast",
