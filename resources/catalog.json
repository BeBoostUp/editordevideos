  "text_animations": {
    "description": "Tipos de animacion para textos con drawtext",
    "items": {
      "fade": {
        "name": "Fade In/Out",
        "desc": "Aparece y desaparece gradualmente",
        "alpha_expr": "if(lt(t,S),0,if(lt(t,S+0.2),(t-S)/0.2,if(lt(t,E-0.2),1,(E-t)/0.2)))"
      },
      "pop": {
        "name": "Pop",
        "desc": "Aparece de golpe con ligero rebote",
        "alpha_expr": "if(lt(t,S),0,if(lt(t,S+0.05),1,if(lt(t,E-0.05),1,0)))"
      },
      "slide_left": {
        "name": "Slide Left",
        "desc": "Entra deslizando desde la izquierda",
        "x_expr": "if(lt(t,S),-text_w,if(lt(t,S+0.3),(-text_w)+(text_w+X)*((t-S)/0.3),X))"
      },
      "slide_right": {
        "name": "Slide Right",
        "desc": "Entra deslizando desde la derecha",
        "x_expr": "if(lt(t,S),w,if(lt(t,S+0.3),w-(w-X)*((t-S)/0.3),X))"
      },
      "slide_up": {
        "name": "Slide Up",
        "desc": "Entra subiendo desde abajo",
        "y_expr": "if(lt(t,S),h,if(lt(t,S+0.3),h-(h-Y)*((t-S)/0.3),Y))"
      },
      "typewriter": {
        "name": "Typewriter",
        "desc": "Aparece letra por letra",
        "note": "Requiere multiples drawtext, uno por caracter"
      },
      "scale_up": {
        "name": "Scale Up",
        "desc": "Crece desde pequeno",
        "fontsize_expr": "if(lt(t,S),0,if(lt(t,S+0.2),FS*(t-S)/0.2,FS))"
      }
    }
  },
