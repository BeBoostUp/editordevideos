  "visual_effects": {
    "description": "Efectos visuales aplicables con FFmpeg",
    "items": {
      "vignette_soft": {
        "name": "Vineta Suave",
        "filter": "vignette=PI/4"
      },
      "vignette_strong": {
        "name": "Vineta Fuerte",
        "filter": "vignette=PI/2.5"
      },
      "blur_light": {
        "name": "Desenfoque Ligero",
        "filter": "gblur=sigma=1"
      },
      "blur_strong": {
        "name": "Desenfoque Fuerte",
        "filter": "gblur=sigma=5"
      },
      "sharpen": {
        "name": "Nitidez",
        "filter": "unsharp=5:5:1.0"
      },
      "sharpen_subtle": {
        "name": "Nitidez Sutil",
        "filter": "unsharp=3:3:0.5"
      },
      "film_grain_light": {
        "name": "Grano Ligero",
        "filter": "noise=alls=10:allf=t+u"
      },
      "film_grain_heavy": {
        "name": "Grano Pesado",
        "filter": "noise=alls=30:allf=t+u"
      },
      "glitch": {
        "name": "Glitch",
        "filter": "noise=alls=50:allf=t,rgbashift=rh=-5:bh=5"
      },
      "mirror_h": {
        "name": "Espejo Horizontal",
        "filter": "crop=iw/2:ih:0:0,split[l][r];[r]hflip[rf];[l][rf]hstack"
      },
      "mirror_v": {
        "name": "Espejo Vertical",
        "filter": "crop=iw:ih/2:0:0,split[t][b];[b]vflip[bf];[t][bf]vstack"
      },
      "flip_h": {
        "name": "Voltear Horizontal",
        "filter": "hflip"
      },
      "flip_v": {
        "name": "Voltear Vertical",
        "filter": "vflip"
      },
      "rotate_90": {
        "name": "Rotar 90",
        "filter": "transpose=1"
      },
      "negative": {
        "name": "Negativo",
        "filter": "negate"
      },
      "posterize": {
        "name": "Posterizar",
        "filter": "hue=s=0,curves=preset=increase_contrast,posterize=4"
      },
      "edge_detect": {
        "name": "Deteccion Bordes",
        "filter": "edgedetect=mode=colormix:high=0"
      },
      "emboss": {
        "name": "Relieve",
        "filter": "convolution='-2 -1 0 -1 1 1 0 1 2:-2 -1 0 -1 1 1 0 1 2:-2 -1 0 -1 1 1 0 1 2'"
      },
      "zoom_pulse": {
        "name": "Pulso Zoom",
        "filter": "zoompan=z='1+0.02*sin(2*PI*t)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1080x1920:fps=30"
      },
      "flash_white": {
        "name": "Flash Blanco",
        "filter": "curves=preset=lighter"
      },
      "flash_black": {
        "name": "Flash Negro",
        "filter": "curves=preset=darker"
      },
      "slow_zoom_in": {
        "name": "Zoom In Lento",
        "filter": "zoompan=z='min(zoom+0.0005,1.15)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1080x1920:fps=30"
      },
      "slow_zoom_out": {
        "name": "Zoom Out Lento",
        "filter": "zoompan=z='if(eq(on,1),1.15,max(zoom-0.0005,1))':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1080x1920:fps=30"
      },
      "shake_light": {
        "name": "Temblor Ligero",
        "filter": "crop=in_w-10:in_h-10:5+random(1)*5:5+random(2)*5"
      },
      "color_negative": {
        "name": "Color Negativo",
        "filter": "curves=preset=color_negative"
      },
      "cross_process": {
        "name": "Cross Process",
        "filter": "curves=preset=cross_process"
      },
      "letterbox": {
        "name": "Barras Cinematicas",
        "filter": "drawbox=0:0:iw:ih*0.12:black:t=fill,drawbox=0:ih-ih*0.12:iw:ih*0.12:black:t=fill"
      }
    }
  },
