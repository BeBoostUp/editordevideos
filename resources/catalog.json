      },
      "high_energy": {
        "name": "Alta Energia",
        "filter": "eq=saturation=1.4:contrast=1.3:brightness=0.05,unsharp=5:5:1.0",
        "mood": "dinamico"
      },
      "golden_hour": {
        "name": "Hora Dorada",
        "filter": "colorbalance=rs=0.2:gs=0.1:bs=-0.15,eq=brightness=0.05:saturation=1.2",
        "mood": "romantico"
      },
      "teal_orange": {
        "name": "Teal & Orange",
