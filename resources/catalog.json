  "visual_effects": {
    "description": "Efectos visuales aplicables con FFmpeg",
    "items": {
      "vignette_soft": {
        "name": "Vineta Suave",
        "filter": "vignette=PI/4"
      },
      "vignette_strong": {
        "name": "Vineta Fuerte",
        "filter": "vignette=PI/2.5"
      },
      "blur_light": {
        "name": "Desenfoque Ligero",
        "filter": "gblur=sigma=1"
      },
      "blur_strong": {
        "name": "Desenfoque Fuerte",
        "filter": "gblur=sigma=5"
      },
      "sharpen": {
        "name": "Nitidez",
        "filter": "unsharp=5:5:1.0"
      },
      "sharpen_subtle": {
        "name": "Nitidez Sutil",
        "filter": "unsharp=3:3:0.5"
      },
      "film_grain_light": {
        "name": "Grano Ligero",
        "filter": "noise=alls=10:allf=t+u"
      },
      "film_grain_heavy": {
        "name": "Grano Pesado",
        "filter": "noise=alls=30:allf=t+u"
      },
      "glitch": {
        "name": "Glitch",
        "filter": "noise=alls=50:allf=t,rgbashift=rh=-5:bh=5"
      },
      "mirror_h": {
        "name": "Espejo Horizontal",
        "filter": "crop=iw/2:ih:0:0,split[l][r];[r]hflip[rf];[l][rf]hstack"
      },
      "mirror_v": {
        "name": "Espejo Vertical",
        "filter": "crop=iw:ih/2:0:0,split[t][b];[b]vflip[bf];[t][bf]vstack"
      },
      "flip_h": {
        "name": "Voltear Horizontal",
        "filter": "hflip"
      },
      "flip_v": {
        "name": "Voltear Vertical",
        "filter": "vflip"
      },
      "rotate_90": {
        "name": "Rotar 90",
        "filter": "transpose=1"
      },
      "negative": {
        "name": "Negativo",
        "filter": "negate"
      },
      "posterize": {
        "name": "Posterizar",
        "filter": "hue=s=0,curves=preset=increase_contrast,posterize=4"
      },
      "edge_detect": {
        "name": "Deteccion Bordes",
        "filter": "edgedetect=mode=colormix:high=0"
      },
      "emboss": {
        "name": "Relieve",
        "filter": "convolution='-2 -1 0 -1 1 1 0 1 2:-2 -1 0 -1 1 1 0 1 2:-2 -1 0 -1 1 1 0 1 2'"
      },
      "zoom_pulse": {
        "name": "Pulso Zoom",
        "filter": "zoompan=z='1+0.02*sin(2*PI*t)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1080x1920:fps=30"
      },
      "flash_white": {
        "name": "Flash Blanco",
        "filter": "curves=preset=lighter"
      },
      "flash_black": {
        "name": "Flash Negro",
        "filter": "curves=preset=darker"
      },
      "slow_zoom_in": {
        "name": "Zoom In Lento",
        "filter": "zoompan=z='min(zoom+0.0005,1.15)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1080x1920:fps=30"
      },
      "slow_zoom_out": {
        "name": "Zoom Out Lento",
        "filter": "zoompan=z='if(eq(on,1),1.15,max(zoom-0.0005,1))':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1080x1920:fps=30"
      },
      "shake_light": {
        "name": "Temblor Ligero",
        "filter": "crop=in_w-10:in_h-10:5+random(1)*5:5+random(2)*5"
      },
      "color_negative": {
        "name": "Color Negativo",
        "filter": "curves=preset=color_negative"
      },
      "cross_process": {
        "name": "Cross Process",
        "filter": "curves=preset=cross_process"
      },
      "letterbox": {
        "name": "Barras Cinematicas",
        "filter": "drawbox=0:0:iw:ih*0.12:black:t=fill,drawbox=0:ih-ih*0.12:iw:ih*0.12:black:t=fill"
      },
      "vhs_full": {
        "name": "VHS Completo",
        "filter": "noise=alls=20:allf=t,rgbashift=rh=3:bh=-3:rv=2:bv=-2,eq=saturation=0.8:contrast=1.1,curves=preset=vintage"
      },
      "vhs_chromatic": {
        "name": "VHS Aberracion",
        "filter": "rgbashift=rh=4:bh=-4:rv=1:bv=-1:edge=smear"
      },
      "glitch_chromatic": {
        "name": "Glitch Cromatico",
        "filter": "rgbashift=rh=10:bh=-10:rv=-5:bv=5:edge=wrap"
      },
      "glitch_heavy": {
        "name": "Glitch Pesado",
        "filter": "rgbashift=rh=20:bh=-20:gh=5:rv=10:bv=-10:edge=smear"
      },
      "datamosh_diff": {
        "name": "Datamosh Diff",
        "filter": "tblend=all_mode=difference"
      },
      "datamosh_phoenix": {
        "name": "Datamosh Phoenix",
        "filter": "tblend=all_mode=phoenix"
      },
      "light_leak": {
        "name": "Light Leak",
        "filter": "colorbalance=rm=0.2:gm=0.05:rs=0.1:rh=0.15:gh=0.05,eq=brightness=0.05"
      },
      "glow_bloom": {
        "name": "Glow/Bloom",
        "filter": "split[a][b];[b]gblur=sigma=30[blurred];[a][blurred]blend=all_mode=screen:all_opacity=0.3"
      },
      "light_trail": {
        "name": "Estela de Luz",
        "filter": "lagfun=decay=0.97"
      },
      "camera_shake": {
        "name": "Temblor Camara",
        "filter": "crop=w=iw-20:h=ih-20:x='10+5*sin(t*25)':y='10+5*cos(t*30)'"
      },
      "heavy_shake": {
        "name": "Temblor Fuerte",
        "filter": "crop=w=iw-40:h=ih-40:x='20+15*sin(t*15)':y='20+15*cos(t*18)'"
      },
      "fisheye": {
        "name": "Ojo de Pez",
        "filter": "lenscorrection=k1=-0.5:k2=-0.2"
      },
      "barrel": {
        "name": "Distorsion Barril",
        "filter": "lenscorrection=k1=0.3:k2=0.1"
      },
      "crt_screen": {
        "name": "Pantalla CRT",
        "filter": "lenscorrection=k1=0.1:k2=0.05,vignette=PI/3"
      },
      "old_film": {
        "name": "Pelicula Antigua",
        "filter": "noise=alls=15:allf=t+p,eq=saturation=0:contrast=1.3,curves=preset=vintage"
      },
      "ghost_trail": {
        "name": "Fantasma/Echo",
        "filter": "tmix=frames=8:weights='8 4 2 1 1 1 1 1':scale=19"
      },
      "motion_blur": {
        "name": "Motion Blur",
        "filter": "tmix=frames=5:weights='1 1 1 1 1'"
      },
      "edge_color": {
        "name": "Bordes Color",
        "filter": "edgedetect=mode=colormix:high=0.1"
      },
      "posterize_heavy": {
        "name": "Posterizar",
        "filter": "elbg=l=16"
      },
      "heatmap": {
        "name": "Mapa de Calor",
        "filter": "pseudocolor=preset=turbo"
      },
      "ken_burns_in": {
        "name": "Ken Burns Zoom In",
        "filter": "zoompan=z='min(zoom+0.001,1.3)':d=125:s=1080x1920:fps=30:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)'"
      },
      "ken_burns_out": {
        "name": "Ken Burns Zoom Out",
        "filter": "zoompan=z='if(eq(on,1),1.3,max(zoom-0.001,1))':d=125:s=1080x1920:fps=30:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)'"
      },
      "letterbox_cinematic": {
        "name": "Barras Cinematicas",
        "filter": "drawbox=0:0:iw:ih*0.12:black:t=fill,drawbox=0:ih-ih*0.12:iw:ih*0.12:black:t=fill"
      },
      "spin_slow": {
        "name": "Giro Lento",
        "filter": "rotate=a=0.02*sin(t*0.5):fillcolor=black"
      },
      "perspective_tilt": {
        "name": "Perspectiva",
        "filter": "perspective=x0=30:y0=0:x1=W-30:y1=0:x2=0:y2=H:x3=W:y3=H"
      },
      "blur_bg_vertical": {
        "name": "Fondo Blur Vertical",
        "filter": "split[orig][bg];[bg]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=25[blurred];[orig]scale=1080:1920:force_original_aspect_ratio=decrease[fg];[blurred][fg]overlay=(W-w)/2:(H-h)/2"
      },
      "animated_blur_in": {
        "name": "Blur Animado (entrada)",
        "filter": "gblur=sigma='max(0,20-t*4)'"
      },
      "whip_pan_left": {
        "name": "Whip Pan Left",
        "filter": "crop=w=iw-60:h=ih:x='30+30*sin(t*20)':y=0",
        "desc": "Barrido rapido izquierda con motion blur"
      },
      "whip_pan_right": {
        "name": "Whip Pan Right",
        "filter": "crop=w=iw-60:h=ih:x='30-30*sin(t*20)':y=0",
        "desc": "Barrido rapido derecha"
      },
      "whip_pan_up": {
        "name": "Whip Pan Up",
        "filter": "crop=w=iw:h=ih-60:x=0:y='30+30*sin(t*20)'",
        "desc": "Barrido rapido arriba"
      },
      "whip_pan_down": {
        "name": "Whip Pan Down",
        "filter": "crop=w=iw:h=ih-60:x=0:y='30-30*sin(t*20)'",
        "desc": "Barrido rapido abajo"
      },
      "spin_clockwise": {
        "name": "Spin Clockwise",
        "filter": "rotate=a=t*PI:fillcolor=black",
        "desc": "Giro horario"
      },
      "spin_counter": {
        "name": "Spin Counter",
        "filter": "rotate=a=-t*PI:fillcolor=black",
        "desc": "Giro antihorario"
      },
      "zoom_spin": {
        "name": "Zoom Spin",
        "desc": "Zoom con giro simultaneo"
      },
      "bounce_warp": {
        "name": "Bounce Warp",
        "desc": "Efecto rebote con deformacion"
      },
      "stutter": {
        "name": "Stutter",
        "filter": "random=frames=5",
        "desc": "Tartamudeo visual (frames aleatorios)"
      },
      "rumble_down": {
        "name": "Rumble Down",
        "filter": "crop=w=iw-20:h=ih-20:x='10+8*sin(t*30)':y='10+8*cos(t*25)'",
        "desc": "Temblor intenso"
      },
      "blur_transition": {
        "name": "Blur Transition",
        "filter": "gblur=sigma='20*(1-min(t,1))'",
        "desc": "Transicion con desenfoque"
      },
      "glitch_premiere_1": {
        "name": "Glitch 1 (Premiere)",
        "filter": "rgbashift=rh=15:bh=-15:edge=wrap",
        "desc": "Glitch estilo Premiere"
      },
      "glitch_premiere_2": {
        "name": "Glitch 2 (Premiere)",
        "filter": "rgbashift=rh=-10:bh=10:rv=5:bv=-5:edge=smear",
        "desc": "Glitch variante 2"
      },
      "warp_spin_cw": {
        "name": "Warp Spin CW",
        "desc": "Giro con deformacion horario"
      },
      "slide_down": {
        "name": "Slide Down (Premiere)",
        "desc": "Deslizamiento hacia abajo con inercia"
      },
      "slide_up": {
        "name": "Slide Up (Premiere)",
        "desc": "Deslizamiento hacia arriba con inercia"
      },
      "roll_in_cw": {
        "name": "Roll In CW",
        "desc": "Entrada rodando horario"
      },
      "roll_in_ccw": {
        "name": "Roll In CCW",
        "desc": "Entrada rodando antihorario"
      }
    }
  },
