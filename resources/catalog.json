  "custom_transitions": {
    "description": "Transiciones personalizadas con expresiones matematicas (transition=custom)",
    "items": {
      "diamond_wipe": {
        "name": "Diamond Wipe",
        "expr": "if(gt(P*2,abs(X/W-0.5)+abs(Y/H-0.5)),B,A)"
      },
      "pinwheel": {
        "name": "Pinwheel",
        "expr": "if(gt(P,0.5+atan2(Y/H-0.5,X/W-0.5)/(2*PI)),B,A)"
      },
      "ripple": {
        "name": "Ripple Dissolve",
        "expr": "A*(1-P)+B*P+sin(10*PI*(X/W+Y/H+P))*0.03*(1-abs(2*P-1))"
      },
      "checkerboard": {
        "name": "Checkerboard",
        "expr": "if(gt(P,0.5*(1+sin(X/W*20)*sin(Y/H*20))),B,A)"
      },
      "h_blinds": {
        "name": "Horizontal Blinds",
        "expr": "if(gt(P,fmod(Y/H*10,1)),B,A)"
      },
      "v_blinds": {
        "name": "Vertical Blinds",
        "expr": "if(gt(P,fmod(X/W*10,1)),B,A)"
      },
      "spiral": {
        "name": "Spiral",
        "expr": "if(gt(P,fmod(atan2(Y/H-0.5,X/W-0.5)/(2*PI)+0.5+hypot(X/W-0.5,Y/H-0.5),1)),B,A)"
      },
      "noise_dissolve": {
        "name": "Noise Dissolve",
        "expr": "if(gt(P,random(1)*0.7+(X*Y)/(W*H)*0.3),B,A)"
      },
      "zoom_reveal": {
        "name": "Zoom Reveal",
        "expr": "if(lt(hypot(X/W-0.5,Y/H-0.5),P),B,A)"
      },
      "burn": {
        "name": "Burn Dissolve",
        "expr": "if(gt(A*(1-P),B*P),A*(1-P),B*P)"
      }
    }
  },
